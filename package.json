{
  "name": "noemi-birthday-trip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node --watch server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "predev": "node scripts/free-dev-ports.mjs",
    "stop:dev": "node scripts/free-dev-ports.mjs",
    "images:birthday": "node scripts/prepare-birthday-images.mjs"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
